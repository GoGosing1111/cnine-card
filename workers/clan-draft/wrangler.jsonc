{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "cnine-card-clan-draft",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "placement": {"mode": "smart"},
  "observability": {"enabled": true},
  "durable_objects": {"bindings": [{"name": "CLAN_DRAFT_ALARM", "class_name": "ClanDraftAlarm"}]},
  "migrations": [{"tag": "clan-draft-alarm-v1", "new_sqlite_classes": ["ClanDraftAlarm"]}],
  "triggers": {"crons": ["* * * * *"]},
  "hyperdrive": [{"binding": "HYPERDRIVE", "id": "6286c0411e9e465b93dfe21ad3f55720"}]
}
