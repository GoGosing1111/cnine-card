<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="숲켓몬 설치" Width="1040" Height="660" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Lime" Color="#C8FF6B"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#C8D3E3"/><Setter Property="Background" Value="#172233"/><Setter Property="BorderBrush" Value="#34435A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#1A2A0F"/><Setter Property="Background" Value="#C8FF6B"/><Setter Property="BorderBrush" Value="#DCFFA5"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Height" Value="60"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#A5B5CB"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderBrush="#506079" BorderThickness="1" Background="#0A1320"><Path x:Name="Tick" Visibility="Collapsed" Data="M 3,8 L 7,12 L 14,4" Stroke="#182B10" StrokeThickness="2"/></Border><ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#C8FF6B"/><Setter TargetName="Box" Property="BorderBrush" Value="#C8FF6B"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F3F6FF"/></Style>
  </Window.Resources>
  <Viewbox Stretch="Uniform">
  <Border Width="1040" Height="660" CornerRadius="18" BorderBrush="#314159" BorderThickness="1" Background="#080E19" ClipToBounds="True">
    <Grid>
      <Border Width="430" HorizontalAlignment="Right" CornerRadius="0,18,18,0" ClipToBounds="True"><Grid><Image Name="WorldArt" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F5080E19" Offset="0"/><GradientStop Color="#38080E19" Offset=".37"/><GradientStop Color="#08080E19" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#50080E19" Offset="0"/><GradientStop Color="#00080E19" Offset=".35"/><GradientStop Color="#00080E19" Offset=".7"/><GradientStop Color="#D0080E19" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle></Grid></Border>
      <Grid Name="TitleBar" Height="54" VerticalAlignment="Top" Background="Transparent" Margin="22,0,12,0"><TextBlock Text="SOOPKETMON  /  SETUP" FontFamily="Segoe UI" FontSize="10" Foreground="#7F91AD" VerticalAlignment="Center" Margin="10,0,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Name="MinimizeButton" Content="−" Width="38" Height="32" Padding="0" Background="Transparent" BorderThickness="0" FontSize="20" AutomationProperties.Name="최소화"/><Button Name="CloseButton" Content="×" Width="38" Height="32" Padding="0" Background="Transparent" BorderThickness="0" FontSize="22" AutomationProperties.Name="닫기"/></StackPanel></Grid>
      <StackPanel Width="520" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="48,76,0,0">
        <Image Name="BrandLogo" Width="154" Height="72" HorizontalAlignment="Left" Stretch="Uniform" Margin="-10,-20,0,2"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,13"><Ellipse Width="5" Height="5" Fill="{StaticResource Lime}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Name="StepLabel" Text="WINDOWS CLIENT" FontFamily="Segoe UI" FontSize="10" Foreground="#C8FF6B"/></StackPanel>
        <TextBlock Name="Headline" Text="숲켓몬,&#10;이제 PC에서." FontSize="39" FontWeight="Bold" LineHeight="49" LineStackingStrategy="BlockLineHeight" Margin="-2,0,0,14"/>
        <TextBlock Name="Description" Text="한 번 받은 리소스는 PC에 보관하고,&#10;다음 접속은 더 가볍게 시작하세요." Foreground="#9DAFC6" FontSize="13" LineHeight="23" TextWrapping="Wrap" Margin="0,0,0,24"/>
        <StackPanel Name="SetupPanel">
          <Border Background="#111C2B" BorderBrush="#2B3C52" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,10"><StackPanel><TextBlock Text="설치 위치" FontSize="11" Foreground="#90A2BA" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><TextBox Name="InstallPath" Foreground="#E7EEF9" CaretBrush="#C8FF6B" SelectionBrush="#456C40" Background="Transparent" BorderThickness="0" FontFamily="Segoe UI" FontSize="12" VerticalContentAlignment="Center" Padding="0,6" AutomationProperties.Name="설치 위치"/><Button Name="BrowseButton" Grid.Column="1" Content="변경" Height="34" Padding="12,4" Margin="12,0,0,0"/></Grid></StackPanel></Border>
          <TextBlock Name="SpaceLabel" Text="설치 공간 확인 중" FontSize="10" Foreground="#7186A2" Margin="2,0,0,18"/>
          <CheckBox Name="ShortcutCheck" Content="바탕화면에 바로가기 만들기" IsChecked="True" Margin="1,0,0,0"/>
        </StackPanel>
        <StackPanel Name="ProgressPanel" Visibility="Collapsed" Margin="0,4,0,0"><TextBlock Name="ProgressHeading" Text="설치 파일 준비 중" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><Border Background="#24344A" Height="5" CornerRadius="3" ClipToBounds="True"><Grid Name="ProgressTrack"><Border Name="ProgressFill" Background="#C8FF6B" HorizontalAlignment="Left" Width="0" CornerRadius="3"/></Grid></Border><TextBlock Name="ProgressDetail" Foreground="#8EA2BC" FontSize="11" TextWrapping="Wrap" LineHeight="20" Margin="0,13,0,0"/></StackPanel>
        <StackPanel Name="CompletePanel" Visibility="Collapsed" Margin="0,0,0,0"><Border BorderBrush="#476139" Background="#13231D" BorderThickness="1" CornerRadius="10" Padding="18,16"><StackPanel><TextBlock Text="✓  전용 클라이언트 설치 완료" Foreground="#D7FBA9" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="기존 숲켓몬 계정으로 로그인할 수 있습니다." Foreground="#8DAA9D" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border></StackPanel>
      </StackPanel>
      <StackPanel Width="520" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="48,0,0,40">
        <TextBlock Name="Notice" Foreground="#F5BD8A" FontSize="11" TextWrapping="Wrap" LineHeight="19" Visibility="Collapsed" Margin="0,0,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><Button Name="InstallButton" Style="{StaticResource Primary}"><Grid Width="330"><TextBlock Name="ActionLabel" Text="설치하기" Foreground="#1A2A0F" FontSize="20" FontWeight="Bold"/><TextBlock Text="→" Foreground="#1A2A0F" FontSize="24" HorizontalAlignment="Right"/></Grid></Button><Button Name="InfoButton" Grid.Column="1" Content="설치 안내" Margin="14,0,0,0" Padding="10,14"/></Grid>
        <TextBlock Name="Footer" Text="WINDOWS 10 / 11 · 인터넷 연결 필요" FontFamily="Malgun Gothic" Foreground="#586F8C" FontSize="9" Margin="2,13,0,0"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,38,43"><TextBlock Text="YOUR NEXT ADVENTURE" FontFamily="Segoe UI" Foreground="#CDDFC9" FontSize="9" HorizontalAlignment="Right"/><Rectangle Fill="#B7D987" Opacity=".7" Width="38" Height="1" HorizontalAlignment="Right" Margin="0,12,0,0"/></StackPanel>
      <Border Name="LicenseOverlay" Visibility="Collapsed" Background="#ED080E19" CornerRadius="18"><Border Background="#111C2B" BorderBrush="#354862" BorderThickness="1" CornerRadius="14" Width="800" Height="530" Padding="30"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="설치 및 이용 안내" FontSize="23" FontWeight="Bold" Margin="0,0,0,22"/><TextBox Name="LicenseText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#BBC9DC" FontSize="13" Padding="0,0,14,0"/><Button Name="LicenseClose" Grid.Row="2" Content="확인" Width="130" HorizontalAlignment="Right" Margin="0,20,0,0" Background="#C8FF6B" Foreground="#182A0F" BorderBrush="#DCFFA5"/></Grid></Border></Border>
    </Grid>
  </Border>
  </Viewbox>
</Window>
