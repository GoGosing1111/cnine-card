{
  "name": "soopketmon-windows",
  "productName": "리버스콜",
  "version": "0.1.10",
  "private": true,
  "description": "리버스콜 Windows 게임 클라이언트와 리소스 런처",
  "author": "YAKCODE",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test ../../tests/windows-client-20261015.test.mjs",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "kr.yakcode.soopketmon",
    "productName": "리버스콜",
    "artifactName": "ReverseCall-Engine-${version}-${arch}.${ext}",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "GoGosing1111",
      "repo": "cnine-card",
      "releaseType": "release"
    },
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "game-preload.cjs",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/icon.ico",
      "executableName": "ReverseCall",
      "requestedExecutionLevel": "asInvoker",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "리버스콜",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "language": "1042",
      "license": "build-resources/LICENSE.txt",
      "include": "build-resources/installer.nsh",
      "guid": "c69fcbf2-955f-5c48-8ff1-55c03889cb40"
    }
  }
}
