  "userChoice": "모바일에도 입장 가능한 모든 전장을 항상 펼쳐 표시한다. 운영 및 계정별 입장 조건을 따른다.",
  "verified": [
    "로비 → 모험 · PVE → PVE 전투",
    "보유 카드 필터·초기화, 전열·후열 카드 제거와 키보드 선택, 명시적 덱 저장",
    "난이도 변경, 대상 선택, 빈 난이도, 행동력·소탕 표시, 아포칼립스 소탕 제외",
    "선택 덱 5장과 몬스터 ID를 전달해 기존 V3 전투 캔버스 진입",
    "웹 /defense/와 원스토어 /onestore/defense/에서 최후의 방어선 대기실 진입"
  ],
  "presentation": {
    "skill": "Impeccable",
    "review": "ship",
    "detector": [],
    "art": "실제 로비 전술 아이콘·9-slice 프레임·서체 스택, 기존 격납고·카드·토벌 원화",
    "narrowScreen": "320px에서 전장 3열 4행, 편성 카드 2열, 상단 전체 메뉴 한 줄. 390px 전열 2장·후열 3장 배치.",
    "cardCrop": "강구열 ICON의 오프셋 지연 로딩 영역에 초기 비율을 부여해 1080×2520 초상화가 실제로 디코딩됨.",
    "fonts": "데스크톱 웹에서 Black Han Sans·Barlow Condensed·Pretendard Variable 로드 확인. 격리 Windows 렌더러에서는 기존 Windows 로비와 동일한 대체 글꼴이 적용됨."
  },
  "performance": {
    "environment": "같은 Windows 호스트에서 이전 운영 커밋과 개편본을 번갈아 실행. Chrome 1440×900, 터치 WebKit 390×844, 별도 프로필의 ReverseCall.exe 1440×900, 공식 H5 SDK를 로드한 Chromium 원스토어 iframe 390×844. 320×844 WebKit 추가 배치 검수.",
    "data": "공개 카드 309종 중 보유 38장, 저장 덱 5장, 토벌 대상 fixture와 전장 표시 조건을 고정. API는 격리하고 브라우저 프로필은 새로 시작. 공개 사이트 확인도 동일한 격리 계정 응답을 사용.",
    "method": "앱 첫 로드에서 조작 가능한 로비까지, PVE 버튼 pointerdown부터 저장 가능한 편성 화면의 다음 페인트까지 측정. 한 번 로비로 나갔다가 같은 버튼으로 재진입. 토벌 대상 교체 동작은 변경 이벤트부터 두 번째 animation frame까지. 최초·재진입 약 600ms, 대상 전환 약 650ms 동안 프레임 간격 및 50ms 초과 집계. 다회 실행 수치는 중앙값이며 원시 값도 보존.",
    "bottleneck": "편성 첫 진입에서 카드 목록 레이아웃과 전투 엔진 실행이 메인 스레드를 점유했다. 화면 밖 카드 목록은 보일 때 구성하고, 엔진은 덱에서 낮은 우선순위로 캐시한 뒤 토벌 탭에서 실행한다. 대상 변경 때 목록을 재생성하지 않는다.",
    "exit": "모든 비교 실행의 이탈 1.15초 뒤 PVE 화면 노드 0개, 행동력 타이머 종료.",
