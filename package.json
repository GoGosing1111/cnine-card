{
  "name": "cnine-card",
  "private": true,
  "type": "module",
  "scripts": {
    "build:v3": "esbuild preview/project-v-v3/source/project-v-pixi-battle.src.js --bundle --minify --format=iife --outfile=preview/project-v-v3/project-v-pixi-battle.bundle.js",
    "test:escort": "node --test tests/escort-operation-v1830.test.mjs",
    "test:postgres-compat": "node --test tests/postgres-d1-compat.test.mjs",
    "test:postgres-routes": "node tests/postgres-route-smoke.mjs",
    "check:worker": "node --check functions/api/[[path]].js",
    "test:raid-entry": "node --test tests/raid-entry-fallback-v1927.test.mjs tests/raid-v3-mobile-recovery-v1930.test.mjs",
    "test:message-rewards": "node --test tests/message-reward-client-parity-v1929.test.mjs",
    "test:workshop": "node --test tests/workshop-split-lineage-v1881.mjs tests/workshop-mystic-energy-v1931.test.mjs tests/equipment-bulk-synthesis-v1941.test.mjs",
    "test:clan": "node --test tests/clan-v3-v1820.mjs tests/clan-war-cms-v1943.test.mjs",
    "test:prison": "node --test tests/prison-system-v1950.test.mjs",
    "test:apocalypse": "node --test tests/pve-apocalypse-v1952.test.mjs",
    "test:battle-suit": "node --test tests/project-v-battle-suit-backend-v1953.test.mjs tests/project-v-battle-suit-frontend-v1953.test.mjs tests/project-v-v3-account-battle-unit-v1953.test.mjs tests/project-v-v3-battle-suit-firearm-qc-v1957.test.mjs",
    "test:territory-reward": "node --test tests/territory-winner-master-star-v1956.test.mjs",
    "release:gate": "npm run check:worker && npm run test:raid-entry && npm run test:message-rewards && npm run test:workshop && npm run test:clan && npm run test:prison && npm run test:apocalypse && npm run test:battle-suit && npm run test:territory-reward && node scripts/verify-production-release.mjs",
    "deploy:production": "npm run release:gate && wrangler pages deploy . --project-name cnine-card --branch main"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "gsap": "^3.13.0",
    "pixi.js": "^8.20.0",
    "sharp": "^0.35.2",
    "wrangler": "^4.125.0"
  }
}
