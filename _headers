# =============================================================
# 관리자 콘솔: 절대 캐시하지 않는다 (기존 4중 중복 블록 → 1개로 정리)
# =============================================================
/admin
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/admin/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/admin/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# =============================================================
# 앱 셸: 항상 재검증 (여기서 ?v= 버전이 결정되므로 캐시 금지)
# =============================================================
/
  Cache-Control: no-cache, must-revalidate, max-age=0
/index.html
  Cache-Control: no-cache, must-revalidate, max-age=0
/offline.html
  Cache-Control: no-cache, must-revalidate, max-age=0
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate, max-age=0
/service-worker.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# =============================================================
# 런타임 번들: 파일명이 콘텐츠 해시가 아니므로 immutable 을 사용하지 않는다.
# ETag 재검증(304)으로 전송량은 아끼면서 새 배포는 즉시 확인한다.
#
#  ⚠️ 운영 규칙: js/ css/ preview/ 아래 파일을 수정하면 참조 URL 의
#     ?v= 값도 반드시 올린다. 서비스워커의 network-first 재검증은
#     누락 시 영구 고정을 막는 2차 안전망이다.
# =============================================================
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/preview/*
  Cache-Control: public, max-age=0, must-revalidate

# =============================================================
# 미디어 / 데이터
# =============================================================
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=60
