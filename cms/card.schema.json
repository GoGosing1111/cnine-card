{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CNINE Card",
  "type": "object",
  "required": [
    "id",
    "name",
    "title",
    "grade",
    "image"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "멤버명"
    },
    "title": {
      "type": "string",
      "description": "카드명"
    },
    "grade": {
      "enum": [
        "C",
        "U",
        "R",
        "SR",
        "HR",
        "UR",
        "SSR",
        "MA",
        "LIMITED",
        "PRESTIGE",
        "FUR"
      ]
    },
    "image": {
      "type": "string"
    },
    "focusX": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 50
    },
    "focusY": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 50
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "basePower": {
      "type": "integer",
      "minimum": 1,
      "description": "PRESTIGE 카드 개별 전투력. 미입력 시 3100"
    },
    "powerType": {
      "enum": [
        "NORMAL",
        "HIGH",
        "TOP",
        "CUSTOM",
        "FIXED",
        null
      ],
      "description": "PRESTIGE는 CUSTOM, FUR는 FIXED"
    }
  }
}
